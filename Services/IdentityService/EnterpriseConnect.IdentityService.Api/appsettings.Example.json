{
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5432;Database=EnterpriseConnect_IdentityDb;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;Include Error Detail=true"
  },
  "JwtSettings": {
    "Secret": "YOUR_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG_HERE",
    "Issuer": "EnterpriseConnect.IdentityService",
    "Audience": "EnterpriseConnect.Clients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "ResendSettings": {
    "ApiKey": "YOUR_RESEND_API_KEY_HERE",
    "FromEmail": "onboarding@resend.dev",
    "FromName": "Enterprise Connect"
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YOUR_GMAIL@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "SenderEmail": "YOUR_GMAIL@gmail.com",
    "SenderName": "Enterprise Connect"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
