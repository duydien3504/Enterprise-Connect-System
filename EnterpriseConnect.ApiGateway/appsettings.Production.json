{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "GatewaySharedSecret": "REDACTED_GATEWAY_SECRET"
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "https://identity.hugonef.id.vn"
          }
        }
      },
      "messaging-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        },
        "Destinations": {
          "messaging-service": {
            "Address": "https://message.hugonef.id.vn"
          }
        }
      },
      "media-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        },
        "Destinations": {
          "media-service": {
            "Address": "https://media.hugonef.id.vn"
          }
        }
      },
      "remote-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        },
        "Destinations": {
          "remote-service": {
            "Address": "https://remote.hugonef.id.vn"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-service": {
            "Address": "https://admin.hugonef.id.vn"
          }
        }
      }
    }
  }
}
